{
  "name": "n8n-nodes-wordpress-nano-banana",
  "version": "4.0.0",
  "description": "n8n community node for generating images using Google Gemini API and optionally uploading to WordPress",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "gemini",
    "google",
    "ai",
    "image-generation",
    "wordpress",
    "featured-image"
  ],
  "license": "MIT",
  "homepage": "https://github.com/tamtinhte365/n8n-nodes-wordpress-nano-banana",
  "author": {
    "name": "tamtinhte365",
    "email": "tamtinhte365@example.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tamtinhte365/n8n-nodes-wordpress-nano-banana.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "tslint -p tsconfig.json -c tslint.json",
    "lintfix": "tslint --fix -p tsconfig.json -c tslint.json",
    "prepublishOnly": "npm run build && npm run lint"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/GeminiApi.credentials.js",
      "dist/credentials/WordPressApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GeminiImageGenerator/GeminiImageGenerator.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "gulp": "^4.0.2",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.3.0"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
